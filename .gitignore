# ==============================================================
# Project-wide .gitignore
# ==============================================================

# Large generated data — never commit
dataset/
artifacts/
benchmark_local_output/
models/

# Runtime artefacts generated by the simulation
outputs/
*.log
*.tmp

# Python compiled files & caches
__pycache__/
*.py[cod]

# Virtual environment
venv/
.env
*.key
*.pem

# IDE / editor artefacts (optional)
.vscode/
.idea/
*.swp
*.suo
*.user
*.DS_Store

# Jupyter / notebook artefacts
.ipynb_checkpoints/
